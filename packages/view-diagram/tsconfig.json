{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // This program typechecks the vendored @modular-svg/* raw .ts source
    // directly, which uses .ts-extension internal imports and doesn't compile
    // under noUncheckedIndexedAccess.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*", "tests/**/*"]
}
