{
  "name": "flow-md",
  "short_name": "flow-md",
  "description": "A browser and a markdown vault in one window",
  "version": "0.0.1",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "borderless",
    "unframed",
    "window-controls-overlay"
  ],
  "background_color": "#1a1a1a",
  "theme_color": "#1a1a1a",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "permissions_policy": {
    "cross-origin-isolated": [
      "self"
    ],
    "controlled-frame": [
      "self"
    ],
    "window-management": [
      "self"
    ]
  }
}
